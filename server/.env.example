# Leave COMPANY_BANK_NAME blank to hide this section entirely.
COMPANY_BANK_NAME=
COMPANY_BENEFICIARY_NAME=
COMPANY_BANK_ACCOUNT=
COMPANY_BANK_IFSC=
COMPANY_BANK_ADDRESS=
